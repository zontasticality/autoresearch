# Allowlist: this repo holds only the research *harness*. Everything at the
# root is ignored unless listed below, so topics/, inbox/, downloads, reports
# and notes can never be committed by accident. Add new harness files here.
/*
!/.bin/
!/.gitignore
!/.gitattributes
!/.gitmodules
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/config.example.json
!/.mcp.json.example
!/setup.sh

# Never commit sources, even inside .bin/
*.pdf
*.epub
*.mobi
*.azw3
*.djvu
*.htm
*.html

# Python cache / editor junk
__pycache__/
*.pyc
.DS_Store
*~
*.swp
